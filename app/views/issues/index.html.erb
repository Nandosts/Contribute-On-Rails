<% content_for :title, t("issues.index.title") %>

<section class="mx-auto max-w-6xl px-6 py-10">
  <header class="mb-8">
    <p class="text-sm font-medium text-slate-500"><%= t("app.tagline") %></p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900"><%= t("issues.index.heading") %></h1>
    <p class="mt-3 max-w-2xl text-slate-600"><%= t("issues.index.description") %></p>
  </header>

  <%= form_with url: issues_path, method: :get, class: "mb-8 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-4" do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: t("issues.filters.search"), class: "rounded-xl border-slate-300 md:col-span-2" %>
    <%= form.collection_select :project_id, @projects, :id, :name, { include_blank: t("issues.filters.all_projects"), selected: params[:project_id] }, class: "rounded-xl border-slate-300" %>
    <%= form.select :category, options_for_select(@categories, params[:category]), { include_blank: t("issues.filters.all_categories") }, class: "rounded-xl border-slate-300" %>
    <div class="flex flex-wrap gap-4 md:col-span-3">
      <% Issue::DEFAULT_LABELS.each do |label| %>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= check_box_tag "labels[]", label, Array(params[:labels]).include?(label), class: "rounded border-slate-300" %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
    <%= form.submit t("issues.filters.submit"), class: "rounded-xl bg-slate-900 px-4 py-2 font-medium text-white" %>
  <% end %>

  <div class="space-y-4">
    <% @issues.each do |issue| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <%= link_to issue.project.name, project_path(issue.project), class: "font-medium text-slate-700" %>
          <span>#<%= issue.number %></span>
          <% issue.labels.each do |label| %>
            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs"><%= label.name %></span>
          <% end %>
        </div>
        <h2 class="mt-3 text-xl font-semibold text-slate-900"><%= link_to issue.title, issue.github_url, target: "_blank", rel: "noopener" %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= t("issues.index.updated", date: l(issue.updated_at_from_github, format: :short)) %></p>
      </article>
    <% end %>
  </div>
</section>
