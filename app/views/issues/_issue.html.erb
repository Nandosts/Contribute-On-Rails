<article class="bg-white shadow-sm p-5 border border-slate-200 rounded-2xl dark:border-slate-850 dark:bg-slate-900">
  <div class="flex flex-wrap items-center gap-2 text-slate-500 text-sm dark:text-slate-400">
    <% unless @group_by_project %>
      <%= link_to "#{issue.project.github_owner}/#{issue.project.github_repo}", project_path(issue.project), class: "font-medium text-slate-700 hover:text-indigo-600 dark:text-slate-300 dark:hover:text-indigo-400 transition-colors" %>
      <span class="text-slate-300 dark:text-slate-600">•</span>
    <% end %>
    <span>#<%= issue.number %></span>

    <% issue.labels.each do |label| %>
      <span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full text-xs shimmer-badge dark:bg-slate-800 dark:text-slate-300">
        <%= label.name %>
      </span>
    <% end %>

    <% if issue.assigned? %>
      <span class="bg-amber-50 px-2 py-1 border border-amber-200 rounded-full font-medium text-amber-800 text-xs dark:bg-amber-950/30 dark:border-amber-900/50 dark:text-amber-400">
        <%= t("issues.index.assigned_to", names: issue.assignee_logins.join(", ")) %>
      </span>
    <% end %>
  </div>

  <h3 class="mt-3 font-semibold text-slate-900 text-xl dark:text-white">
    <%= link_to issue.title, issue.github_url, target: "_blank", rel: "noopener", class: "hover:text-indigo-600 dark:hover:text-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none rounded transition-colors" %>
  </h3>

  <p class="mt-2 text-slate-600 text-sm dark:text-slate-400">
    <%= t("issues.index.opened", date: l(issue.opened_at, format: :long)) %>
    ·
    <%= t("issues.index.updated", date: l(issue.updated_at_from_github, format: :long)) %>
  </p>
</article>
