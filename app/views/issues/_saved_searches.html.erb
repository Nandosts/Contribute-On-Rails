<details class="mb-4 rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <summary class="cursor-pointer px-5 py-4 text-sm font-semibold text-slate-900 marker:text-indigo-500 dark:text-white">
    <%= t("issues.saved_searches.label") %>
    <span class="ml-2 font-normal text-slate-500 dark:text-slate-400"><%= t("issues.saved_searches.description") %></span>
  </summary>

  <div class="border-t border-slate-200 px-5 py-4 dark:border-slate-800">
    <div class="flex flex-col gap-2 sm:flex-row">
      <%= text_field_tag :saved_search_name, nil, placeholder: t("issues.saved_searches.name_placeholder"), aria: { label: t("issues.saved_searches.name_placeholder") }, class: "h-10 flex-1 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-white", data: { saved_searches_target: "name", action: "keydown->saved-searches#save" } %>
      <%= button_tag t("issues.saved_searches.save"), type: "button", class: "h-10 cursor-pointer rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600", data: { action: "saved-searches#save" } %>
    </div>

    <p class="mt-2 min-h-5 text-xs text-emerald-600 dark:text-emerald-400" role="status" aria-live="polite" data-saved-searches-target="feedback"></p>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400" data-saved-searches-target="empty"><%= t("issues.saved_searches.empty") %></p>
    <ul class="mt-3 space-y-2" data-saved-searches-target="list"></ul>
  </div>
</details>
