<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || "Contribute On Rails" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Contribute On Rails">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <link
      rel="modulepreload"
      href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/+esm"
    >

    <%= javascript_importmap_tags %>

    <script nonce="<%= request.content_security_policy_nonce %>">
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body class="relative bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-50">
    <!-- Animated Neon Background Blobs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 select-none">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-500/10 dark:bg-indigo-500/8 rounded-full blur-3xl animate-float-slow"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-pink-500/10 dark:bg-pink-500/6 rounded-full blur-3xl animate-float-delayed"></div>
      <div class="absolute -bottom-40 left-1/4 w-96 h-96 bg-cyan-500/10 dark:bg-cyan-500/6 rounded-full blur-3xl animate-float-slow"></div>
    </div>

    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/80 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/80">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <div class="flex items-center gap-8">
          <%= link_to root_path, class: "group flex items-center gap-3 font-bold text-slate-900 tracking-tight text-lg transition hover:opacity-90 dark:text-white" do %>
            <div class="relative flex items-center justify-center p-1.5 rounded-xl bg-slate-100 border border-slate-200 group-hover:border-indigo-400/50 transition-colors dark:bg-slate-900 dark:border-slate-800 dark:group-hover:border-indigo-500/50">
              <!-- Cybernetic glowing ring behind the logo on group hover -->
              <div class="absolute inset-0 rounded-xl bg-gradient-to-tr from-indigo-500 via-pink-500 to-cyan-400 opacity-0 blur-xs group-hover:opacity-40 group-hover:animate-spin-slow transition-opacity duration-500"></div>
              <%= image_tag "/icon.svg", class: "relative h-6 w-6 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-12", alt: "Logo" %>
            </div>
            <span>Contribute on Rails</span>
          <% end %>

          <nav class="flex items-center gap-6" aria-label="Navigation">
            <%= link_to t("layout.nav.issues"), root_path, class: "text-sm font-semibold transition #{controller_name == 'issues' ? 'text-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100'}" %>
            <%= link_to t("layout.nav.projects"), projects_path, class: "text-sm font-semibold transition #{controller_name == 'projects' ? 'text-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100'}" %>
          </nav>
        </div>

        <div class="flex items-center gap-4">
          <button
            type="button"
            data-controller="theme"
            data-action="click->theme#toggle"
            class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:bg-slate-50 hover:text-slate-800 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
            aria-label="Toggle theme"
          >
            <svg data-theme-target="lightIcon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
            <svg data-theme-target="darkIcon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
            </svg>
          </button>

          <div class="flex items-center gap-1 rounded-full bg-slate-100 p-0.5 border border-slate-200/80 dark:bg-slate-800 dark:border-slate-700">
            <%= link_to "EN", url_for(params.to_unsafe_h.merge(locale: "en")), class: "rounded-full px-2.5 py-1 text-xs font-bold transition #{I18n.locale == :en ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100'}" %>
            <%= link_to "PT", url_for(params.to_unsafe_h.merge(locale: "pt-BR")), class: "rounded-full px-2.5 py-1 text-xs font-bold transition #{I18n.locale == :"pt-BR" ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100'}" %>
          </div>
        </div>
      </div>
    </header>

    <main class="min-h-[calc(100vh-14rem)]">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-200/80 bg-white/40 backdrop-blur-md dark:border-slate-800/85 dark:bg-slate-950/40 py-8 mt-16 text-xs text-slate-500 dark:text-slate-400">
      <div class="mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-mono tracking-tight text-[11px] text-slate-600 dark:text-slate-300">
            WEB4 NODE ACTIVE · SYNCED VIA SOLID QUEUE
          </span>
        </div>
        <div class="flex items-center gap-4">
          <span class="font-medium text-slate-600 dark:text-slate-400">Contribute on Rails &copy; <%= Time.current.year %></span>
          <span class="text-slate-300 dark:text-slate-800">|</span>
          <%= link_to "AI Rules", "/.agents/AGENTS.md", class: "font-semibold hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors underline decoration-dotted underline-offset-2" %>
        </div>
      </div>
    </footer>
  </body>
</html>
