<section class="mx-auto max-w-5xl px-6 py-10">
  <h1 class="text-3xl font-bold text-slate-900"><%= t("projects.index.heading") %></h1>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <% @projects.each do |project| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-xl font-semibold"><%= link_to project.name, project_path(project) %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= project.source_category %></p>
        <p class="mt-2 text-sm text-slate-600"><%= t("projects.index.open_issues", count: project.open_issues_count) %></p>
      </article>
    <% end %>
  </div>
</section>
