<% content_for :title, t("projects.index.heading") %>

<section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
  <header class="mb-10 animate-fade-in-up">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300 dark:border dark:border-indigo-800/40 shadow-sm mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
      <%= t("app.tagline") %>
    </div>

    <h1 class="mt-2 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 bg-clip-text text-3xl font-extrabold tracking-tight text-transparent sm:text-4xl dark:from-white dark:via-indigo-200 dark:to-white">
      <%= t("projects.index.heading") %>
    </h1>

    <p class="mt-3 text-slate-600 dark:text-slate-300">
      <%= t("app.tagline") %>
    </p>
  </header>

  <div class="grid gap-4 md:grid-cols-2 animate-fade-in-up">
    <% @projects.each do |project| %>
      <article
        class="
          rounded-2xl border border-slate-200 bg-white p-5 shadow-sm
          dark:border-slate-800 dark:bg-slate-900
        "
      >
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h2 class="min-w-0 break-words text-lg font-semibold text-slate-900 dark:text-white">
            <%= link_to project.name, project_path(project), class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none rounded" %>
          </h2>

          <span class="shrink-0 bg-slate-900 px-2.5 py-1 rounded-full font-semibold text-white text-xs dark:bg-slate-800 dark:text-slate-200">
            <%= t("projects.index.open_issues", count: project.open_issues_count) %>
          </span>
        </div>

        <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
          <%= project.source_category %>
        </p>
      </article>
    <% end %>
  </div>
</section>
