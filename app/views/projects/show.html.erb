<section class="mx-auto max-w-5xl px-6 py-10">
  <% if params[:from_random].present? %>
    <%= link_to t("projects.show.back_to_issues"), issues_path, class: "mb-6 inline-flex cursor-pointer items-center rounded-xl border border-slate-300 bg-white px-4 py-2 font-medium text-slate-900 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  <% end %>
  <p class="text-sm text-slate-500"><%= @project.source_category %></p>
  <h1 class="mt-2 text-3xl font-bold text-slate-900"><%= @project.name %></h1>
  <p class="mt-3 text-sm text-slate-600"><%= t("projects.show.last_synced", date: @project.last_synced_at ? l(@project.last_synced_at, format: :short) : t("projects.show.never")) %></p>

  <%= form_with url: project_path(@project), method: :get, class: "mt-6 max-w-xs" do |form| %>
    <%= form.label :updated_since, t("issues.filters.updated_since"), class: "sr-only" %>
    <%= form.select :updated_since, options_for_select([[t("issues.filters.any_time"), ""], [t("issues.filters.last_30_days"), 30], [t("issues.filters.last_90_days"), 90], [t("issues.filters.last_year"), 365]], params[:updated_since]), {}, class: "select-control", data: { controller: "select" }, onchange: "this.form.requestSubmit()" %>
  <% end %>

  <div class="mt-8 space-y-4">
    <% @issues.each do |issue| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-3 flex flex-wrap gap-2">
          <% issue.labels.each do |label| %>
            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= label.name %></span>
          <% end %>
        </div>
        <h2 class="text-xl font-semibold text-slate-900"><%= link_to issue.title, issue.github_url, target: "_blank", rel: "noopener" %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= t("issues.index.opened", date: l(issue.opened_at, format: :short)) %> · <%= t("issues.index.updated", date: l(issue.updated_at_from_github, format: :short)) %></p>
      </article>
    <% end %>
  </div>
</section>
