<section class="mx-auto px-6 py-10 max-w-5xl">
  <% if params[:from_random].present? %>
    <%= link_to t("projects.show.back_to_issues"), issues_path, class: "mb-6 inline-flex cursor-pointer items-center rounded-xl border border-slate-300 bg-white px-4 py-2 font-medium text-slate-900 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  <% end %>

  <p class="text-slate-500 text-sm"><%= @project.source_category %></p>

  <h1 class="mt-2 font-bold text-slate-900 text-3xl"><%= @project.name %></h1>

  <p class="mt-3 text-slate-600 text-sm">
    <%= t("projects.show.last_synced", date: @project.last_synced_at ? l(@project.last_synced_at, format: :long) : t("projects.show.never")) %>
  </p>

  <%= form_with url: project_path(@project), method: :get, class: "mt-6 max-w-xs" do |form| %>
    <%= form.label :updated_since, t("issues.filters.updated_since"), class: "sr-only" %>
    <%= form.select :updated_since, options_for_select([[t("issues.filters.any_time"), ""], [t("issues.filters.last_30_days"), 30], [t("issues.filters.last_90_days"), 90], [t("issues.filters.last_year"), 365]], params[:updated_since]), {}, class: "select-control", data: { controller: "select" }, onchange: "this.form.requestSubmit()" %>
  <% end %>

  <div class="space-y-4 mt-8">
    <% @issues.each do |issue| %>
      <article class="bg-white shadow-sm p-5 border border-slate-200 rounded-2xl">
        <div class="flex flex-wrap gap-2 mb-3">
          <% issue.labels.each do |label| %>
            <span class="bg-slate-100 px-2 py-1 rounded-full text-slate-700 text-xs">
              <%= label.name %>
            </span>
          <% end %>
        </div>

        <h2 class="font-semibold text-slate-900 text-xl">
          <%= link_to issue.title, issue.github_url, target: "_blank", rel: "noopener" %>
        </h2>

        <p class="mt-2 text-slate-500 text-sm">
          <%= t("issues.index.opened", date: l(issue.opened_at, format: :long)) %>
          ·
          <%= t("issues.index.updated", date: l(issue.updated_at_from_github, format: :long)) %>
        </p>
      </article>
    <% end %>
  </div>
</section>
