# GitHub API Token (required to fetch issues and avoid rate limiting)
# Create one at https://github.com/settings/tokens
# GITHUB_TOKEN=

# When set to true, disables importing projects from the remote upstream README catalog
# and only syncs projects defined in config/curated_projects.yml.
IGNORE_UPSTREAM_PROJECTS=false

# If using Postgres with a password, configure it here:
# CONTRIBUTE_ON_RAILS_DATABASE_PASSWORD=

# Set to true if you want to run Solid Queue background processor embedded inside the Puma web server.
# Useful for simple deployments (e.g. Render, Heroku) without a separate worker process.
# SOLID_QUEUE_IN_PUMA=false
